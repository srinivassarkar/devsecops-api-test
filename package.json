{
  "name": "devsecops-nodejs-api",
  "version": "1.0.0",
  "description": "A secure Node.js API for DevSecOps demonstration",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "security:audit": "npm audit",
    "security:sast": "semgrep --config=auto .",
    "security:dependency": "npm audit --audit-level high"
  },
  "keywords": [
    "nodejs",
    "api",
    "devsecops",
    "security",
    "express"
  ],
  "author": "DevSecOps Engineer",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.6.1",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
